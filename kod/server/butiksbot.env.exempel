# Min Butik-boten. Den här filen ska ha rättigheter 600 (chmod 600 butiksbot.env).
# Klistra in token från @BotFather direkt efter =, utan citattecken.
TELEGRAM_TOKEN=
# Telegram-ID:n som får använda boten, separerade med komma.
# Lämna tom första gången: då svarar boten med ditt ID.
ALLOWED_IDS=
# AI (känna igen varor på foton, läsa priser, välja nätbilder, tolka oklar text).
# Gemini-nyckel från aistudio.google.com/apikey – gratisnivån räcker. Används i första hand.
GEMINI_API_KEY=
# Utan någon nyckel frågar boten i stället vad varan heter.

# Valfritt: fler och bättre nätbilder (gratis nyckel på pixabay.com/api/docs)
# PIXABAY_API_KEY=
# Valfritt: andra fria bildkällan (gratis nyckel på pexels.com/api)
# PEXELS_API_KEY=

# Valfritt: Facebook-länk -> annons (sidnyckel för butikens sida)
# FACEBOOK_SIDTOKEN=
